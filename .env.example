# Copy to .env (same folder as docker-compose.yml) and fill in.
# docker compose reads .env automatically; never commit the real one.

# Host port the app is published on
APP_PORT=8123

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Hostname used for links in emails
SERVER_NAME_FOR_EMAILS=wishlist.example.com

# Email Configuration (Gmail with App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=you@gmail.com

# Gemini AI (profile photo transformation + gift poems)
GEMINI_API_KEY=your-gemini-api-key
# Optional model overrides (defaults: gemini-3-pro-image / gemini-3.1-flash-image / gemini-3.6-flash)
#GEMINI_IMAGE_MODEL=
#GEMINI_IMAGE_FALLBACK_MODEL=
#GEMINI_TEXT_MODEL=

# Where persistent data lives on the Unraid server (outside docker.img).
# Keep the appdata share on the cache pool (Primary: cache, no Secondary) so
# the mover never touches live database files.
DB_DIR=/mnt/user/appdata/christmas-app-db
DATA_DIR=/mnt/user/appdata/christmas-app-data

# Database. Only applied when the database is first created; changing it
# later does not change the existing database's password.
POSTGRES_USER=christmas
POSTGRES_PASSWORD=christmas
POSTGRES_DB=christmas_app

# Backups (written to ./backups unless BACKUP_DIR is set)
#BACKUP_DIR=/mnt/user/backups/christmas-app
BACKUP_KEEP_DAYS=14
# Local timezone (countdowns, reminder emails, backup names), e.g. America/Chicago
TZ=UTC
# Hour of day (0-23, local time) the daily reminder emails go out
REMINDER_HOUR=9

# Push notifications: nothing to set. The key pair is created on first start
# and kept in the database. Optional overrides:
#VAPID_SUBJECT=mailto:you@gmail.com
#VAPID_PRIVATE_KEY=
